{
  "expo": {
    "name": "OKUANI",
    "slug": "okuani",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.okuani.mobile"
    },
    "android": {
      "package": "com.okuani.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#123A28",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "OKUANI needs access to your photos to set your profile picture, ID photo, and product photos.",
          "cameraPermission": "OKUANI needs camera access to let you take photos for your ID and produce listings."
        }
      ]
    ]
  }
}
